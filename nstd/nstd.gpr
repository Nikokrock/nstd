with "config/nstd_constants.gpr";

library project NStd is
   --  Version handling is managed by the build script that use the VERSION
   --  file as reference for the library version
   --  (used only when building a shared library)
   Version := External(
      "NSTD_VERSION",
      NStd_Constants.NSTD_VERSION_DEFAULT);

   --  Get the current OS type. The value is used to compute the expected
   --  shared library extension. The user can use this value to have system
   --  specific configurations (for example in Naming package).
   --  (used only when building a shared library)
   type OS_Kind is ("windows", "unix", "osx");
   OS : OS_Kind := External
      ("NSTD_OS",
      NStd_Constants.NSTD_OS_DEFAULT);

   --  Used to select a DEBUG or PROD build
   type Build_Type is ("DEBUG", "PROD");
   Build : Build_Type := External
      ("NSTD_BUILD_MODE",
      External
         ("BUILD",
          NStd_Constants.NSTD_BUILD_MODE_DEFAULT));

   --  Kind of library to be built
   type Library_Types is ("relocatable", "static", "static-pic");
   Library_Type : Library_Types := External ("LIBRARY_TYPE", "static");

   Finalization := External
      ("NSTD_FINALIZATION",
       NStd_Constants.NSTD_FINALIZATION_DEFAULT);
   Reference_Counting := External
      ("NSTD_REFCOUNT",
       NStd_Constants.NSTD_REFCOUNT_DEFAULT);
   Malloc := External
      ("NSTD_MALLOC", NStd_Constants.NSTD_MALLOC_DEFAULT);

   Project_Languages := ("Ada", "C", "C++");
   Sources := ("src", "src/simdutf");

   for Languages use Project_Languages;

    for Source_Dirs use Sources;
    --  If the library is built out of tree, and is used by an external
    --  afterwards, then NSTD_OBJECT_ROOT can be used so
    --  nstd.gpr Object_Dir and Library_Dir point to
    --  the correct directory.
    Object_Root := external ("NSTD_OBJECT_ROOT", "");

    case OS is
       when "windows" | "osx" =>
          --  On MacOS and Windows all object are relocatable by default
          --  thus the same object directory can be used
          for Object_Dir use Object_Root & "obj/nstd/all";
       when "unix" =>
          --  On Unix static-pic and relocatable shared the same objects
          case Library_Type is
             when "relocatable" | "static-pic" =>
                for Object_Dir use Object_Root & "obj/nstd/pic";
             when "static" =>
                for Object_Dir use Object_Root & "obj/nstd/static";
          end case;
    end case;

    for Library_Name use "nstd";
    for Library_Kind use Library_Type;
    for Library_Dir
        use Object_Root & "lib/nstd/" & Project'Library_Kind;
    package Ide is
        for VCS_Kind use "Git";
    end Ide;

    So_Ext := "";
    case OS is
        when "windows" =>
           So_Ext := ".dll";
        when "osx" =>
           So_Ext := ".dylib";
        when others =>
           So_Ext := ".so";
    end case;

    for Library_Version use "lib" & Project'Library_Name & So_Ext & "." & Version;

    package Compiler is
       case Build is
          when "DEBUG" =>
             for Switches ("Ada") use (
                 --  Standard debugging flags (debug info and no optimisation)
                 "-g", "-O0",
                 --  Enable pragma Assert and Debug
                 "-gnata",
                 --  Turn on all the validity checks
                 "-gnatVa",
                 --  Write ali/tree file even if compile errors
                 "-gnatQ",
                 --  Enable default style checks
                 "-gnaty",
                 --  Add extra information in exception messages
                 "-gnateE",
                 --  Activate default warnings and mark all warnings as error
                 "-gnatwae",
                 --  Activate stack checking
                 "-fstack-check");
             for Switches ("C") use ("-g", "-O0", "-Wunreachable-code");

          when "PROD" =>
             --  Enable optimisation and inlining. Do not treat warnings as
             --  errors.
             --  Note that -O3 is not used for Ada packages as it might leads to
             --  inlining of functions that should not be inlined.
             for Switches ("Ada") use ("-O2", "-gnatn", "-gnatwa");
             for Switches ("C") use ("-O2", "-Wunreachable-code", "-DMI_BUILD_RELEASE=1");
             for Switches ("C++") use ("-O3");
       end case;
    end Compiler;

    package Binder is
       case Build is
          when "DEBUG" =>
             --  For symbolic bactrace
             for Switches ("Ada") use ("-E");
          when "PROD" =>
             null;
       end case;
   end Binder;

   package Naming is

      for Specification ("NStd.Lifecycle")
        use "nstd-lifecycle__" & Finalization  & "_" & Reference_Counting & ".ads";
      for Implementation ("NStd.Lifecycle")
        use "nstd-lifecycle__" & Finalization  & "_" & Reference_Counting & ".adb";
      for Specification ("NStd.Memory")
        use "nstd-memory__" & Malloc & ".ads";
   end Naming;
end NStd;
